{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:stop": "lsof -ti :3000 | xargs kill 2>/dev/null || true",
    "dev:clean": "npm run dev:stop && rm -f .next/dev/lock && next dev -p 3000",
    "build": "next build",
    "email:dev": "email dev --dir emails --port 3001",
    "favicons": "node scripts/generate-favicons.mjs",
    "blur-placeholders": "node scripts/generate-blur-placeholders.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "start:next": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tailwindcss/postcss": "^4",
    "framer-motion": "^12.40.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/node": "20.19.42",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "react-email": "^6.6.0"
  }
}
