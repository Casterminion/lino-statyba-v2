# Public site URL (used for SEO metadata and email links)
NEXT_PUBLIC_SITE_URL=https://www.linostatyba.lt

# Resend — contact form email delivery
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Upstash Redis — contact form rate limiting (3/min, 10/hour per IP)
# Create a database at https://console.upstash.com/
# Fail-open: requests are allowed if these are unset or Redis is unreachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
